(set-info :status unsat)
(set-info :inox-may-be-unknown true)
(declare-datatypes ((List 1)) ((par (A) ((Nil) (Cons (head A) (tail (List A)))))))
(declare-type-var A)
(define-fun-rec size ((l (List A))) Int (ite ((_ is Cons) l) (+ 1 (size (tail l))) 0))
; size has no postcondition, so the solver can only time out
(set-option :timeout 0.1)
(declare-const x (List Int))
(assert (< (size x) 0))
(check-sat)
