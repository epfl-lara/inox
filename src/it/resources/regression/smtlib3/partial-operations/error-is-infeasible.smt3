; No model evaluates an error: a query that reaches one in each of its models is unsat
(set-option :assume-checked false)
(set-option :check-models true)
(define-fun-rec count ((x Int)) Int
  (ite (< x 0) (error Int "negative") (ite (= x 0) 0 (+ 1 (count (- x 1))))))
(declare-const y Int)
(push 1)
(set-info :status unsat)
(assert (and (< y 2) (not (= (count y) y))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (and (< y 0) (= (count y) 0)))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (= (ite (> y 0) (error Bool "positive") (> y 0)) (> y 0)))
(assert (> y 0))
(check-sat)
(pop 1)
(set-info :status sat)
(assert (= (count y) 1))
(check-sat)
