; Princess encodes reals as fractions, whose division also fails on zero
(set-option :assume-checked false)
(set-option :check-models true)
(declare-const x Real)
(declare-const y Real)
(assert (= y 0.0))
(push 1)
(set-info :status unsat)
(assert (= (/ x y) 1.0))
(check-sat)
(pop 1)
(set-info :status sat)
(assert (= (ite (= y 0.0) 0.0 (/ x y)) 0.0))
(check-sat)
