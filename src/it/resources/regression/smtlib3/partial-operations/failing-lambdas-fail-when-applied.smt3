; A lambda whose body divides by zero only fails when it is applied
(set-option :function-equality intensional)
(set-option :assume-checked false)
(set-option :check-models true)
(declare-const y Int)
(declare-const f (-> Int Int))
(assert (= y 0))
(assert (= f (lambda ((x Int)) (div x y))))
(push 1)
(set-info :status sat)
(check-sat)
(pop 1)
(set-info :status unsat)
(assert (= (@ f 1) 2))
(check-sat)
