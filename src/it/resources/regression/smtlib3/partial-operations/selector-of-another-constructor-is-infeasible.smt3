; Selecting a field of another constructor fails in the evaluator
(set-option :assume-checked false)
(set-option :check-models true)
(declare-datatypes ((List 0)) (((Nil) (Cons (head Int) (tail List)))))
(declare-const l List)
(push 1)
(set-info :status unsat)
(assert ((_ is Nil) l))
(assert (= (head l) 1))
(check-sat)
(pop 1)
(set-info :status sat)
(assert (= (head l) 1))
(check-sat)
