; A division by zero fails in the evaluator, so it makes its path infeasible
(set-option :assume-checked false)
(set-option :check-models true)
(declare-const x Int)
(declare-const y Int)
(assert (= y 0))
(push 1)
(set-info :status unsat)
(assert (= (div x y) 5))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (= (div x y) 5)))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (= (mod x y) 1))
(check-sat)
(pop 1)
(set-info :status sat)
(assert (= (ite (= y 0) 0 (div x y)) 0))
(check-sat)
