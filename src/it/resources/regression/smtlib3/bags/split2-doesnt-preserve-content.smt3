(set-info :status sat)
(declare-datatypes ((List 1)) ((par (A) ((Nil) (Cons (head A) (tail (List A)))))))
(declare-type-var A)
(define-fun-rec bag ((l (List A))) (Bag A)
  (ite ((_ is Cons) l) (bag.insert (bag (tail l)) (head l)) (as bag.empty A)))
; split(l) = (l1, l2) where bag(l) == bag(l1) ++ bag(l2), which is assumed for the recursive calls
(define-fun-rec split ((l (List A))) (Tuple (List A) (List A))
  (let ((res (ite (and ((_ is Cons) l) ((_ is Cons) (tail l)))
                  (let ((t (split (tail (tail l)))))
                    (tuple (Cons (head l) ((_ tuple.select 0) t)) (Cons (head (tail l)) ((_ tuple.select 1) t))))
                  (tuple l (as Nil (List A))))))
    (assume (= (bag l) (bag.union (bag ((_ tuple.select 0) res)) (bag ((_ tuple.select 1) res)))) res)))
(declare-type T ())
(declare-const l (List T))
; the same body as split, but the second list drops the last element of odd-length lists
(assert (not (let ((res (ite (and ((_ is Cons) l) ((_ is Cons) (tail l)))
                             (let ((t (split (tail (tail l)))))
                               (tuple (Cons (head l) ((_ tuple.select 0) t)) (Cons (head (tail l)) ((_ tuple.select 1) t))))
                             (tuple (as Nil (List T)) (as Nil (List T))))))
  (= (bag l) (bag.union (bag ((_ tuple.select 0) res)) (bag ((_ tuple.select 1) res)))))))
(check-sat)
