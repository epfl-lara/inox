(set-info :status sat)
(declare-type A ())
(declare-const bag (Bag A))
(declare-const e1 A)
(declare-const v1 Int)
(declare-const e2 A)
(declare-const v2 Int)
(assert (not (= bag (bag.union (bag.union (as bag.empty A) (bag.singleton e1 v1)) (bag.singleton e2 v2)))))
(assert (not (= (bag.multiplicity e1 bag) 0)))
(assert (not (= (bag.multiplicity e2 bag) 0)))
(check-sat)
