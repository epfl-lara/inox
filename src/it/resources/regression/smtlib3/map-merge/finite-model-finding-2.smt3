(set-info :status sat)
(declare-type K ())
(declare-type V ())
(declare-const mask (Set K))
(declare-const map1 (Array K V))
(declare-const map2 (Array K V))
(declare-const dummyValue V)
(declare-const someKey K)
(define-fun merged () (Array K V) (map.merge mask map1 map2))
(assert (not (= merged map1)))
(check-sat)
