(set-info :status sat)
(declare-type-var T)
(declare-fun pos1 (Int) (! Int :var v :restrict (> v 0)))
(define-fun fun1 ((x Int)) Int (ite (<= x 0) (pos1 x) x))
(declare-fun pos2 (Int Int) (! Int :var v :restrict (> v 0)))
(define-fun fun2 ((x Int) (y Int)) Int (ite (<= x 0) (pos2 x y) (fun1 y)))
(declare-fun any3 (T Bool) T)
(define-fun fun3 ((x T) (b Bool)) T (ite b (any3 x b) x))
(declare-fun above4 ((x Int) (y Int)) (! Int :var v :restrict (> v y)))
(define-fun-rec fun4 ((x Int) (y Int)) Int
  (ite (>= x 0) (+ (above4 x y) (fun4 (- x 1) (- y 1))) 0))
(declare-fun nonzero5 ((x Int)) (! Int :var r :restrict (not (= (fun3 x true) 0))))
(define-fun fun5 ((x Int)) Int (nonzero5 x))
(assert (= (fun1 (- 1)) 10))
(check-sat)
