; The refinement of makeEqual is only assumed when its lambda is applied, which never happens
; here, so x and y can differ (epfl-lara/inox#139)
(set-info :status sat)
(declare-datatypes ((Unit 0)) (((Uu))))
(declare-datatypes ((Equations 2)) ((par (A B) ((Equation (lhs (-> A)) (rhs (-> A)) (ev (-> B)))))))
(declare-fun makeEqual ((x Int) (y Int)) (! Unit :var u :restrict (= x y)))
(declare-const x Int)
(declare-const y Int)
(declare-const eq1 (Equations Int Unit))
(declare-const eq2 (Equations Int Unit))
(assert (= eq1 (Equation (lambda () x) (lambda () x) (lambda () (makeEqual x y)))))
(assert (= eq2 (Equation (lambda () x) (lambda () x) (lambda () Uu))))
(assert (not (= y x)))
(check-sat)
