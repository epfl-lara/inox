; A map of functions defined by a lambda contains all keys
(set-info :status sat)
(declare-datatypes ((Option 1)) ((par (A) ((None) (Some (value A))))))
(declare-datatypes ((MMap 2)) ((par (A B) ((MMap (f (-> A (Option B))))))))
(declare-type-var A)
(declare-type-var B)
(define-fun contains ((m (MMap A B)) (k A)) Bool ((_ is Some) (@ (f m) k)))
(assert (not (let ((states (MMap (lambda ((i Int)) (Some (lambda ((x Int)) 0))))))
  (and (contains states 0) false))))
(check-sat)
