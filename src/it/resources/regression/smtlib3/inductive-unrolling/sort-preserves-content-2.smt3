(set-info :status unsat)
(declare-datatypes ((List 1)) ((par (A) ((Nil) (Cons (head A) (tail (List A)))))))
(declare-type-var A)
(declare-type-var B)
(declare-type-var C)
(define-fun-rec content ((l (List A))) (Set A)
  (ite ((_ is Cons) l) (insert (content (tail l)) (head l)) (as emptyset A)))
(define-fun-rec append ((l1 (List A)) (l2 (List A))) (List A)
  (let ((res (ite ((_ is Cons) l1) (Cons (head l1) (append (tail l1) l2)) l2)))
    (assume (= (content res) (union (content l1) (content l2))) res)))
(define-fun-rec all ((l (List A)) (p (-> A Bool))) Bool
  (ite ((_ is Cons) l) (and (p (head l)) (all (tail l) p)) true))
(define-fun-rec partition ((l (List A)) (p (-> A Bool))) (Tuple (List A) (List A))
  (let ((res (ite ((_ is Cons) l)
                  (let ((ptl (partition (tail l) p)))
                    (ite (p (head l))
                      (tuple (Cons (head l) ((_ tuple.select 0) ptl)) ((_ tuple.select 1) ptl))
                      (tuple ((_ tuple.select 0) ptl) (Cons (head l) ((_ tuple.select 1) ptl)))))
                  (tuple l l))))
    (assume (and (all ((_ tuple.select 0) res) p)
                 (all ((_ tuple.select 1) res) (lambda ((x A)) (not (p x))))
                 (= (content l) (union (content ((_ tuple.select 0) res)) (content ((_ tuple.select 1) res)))))
      res)))
(define-fun-rec sort ((l (List A)) (lt (-> A A Bool))) (List A)
  (let ((res (ite ((_ is Cons) l)
                  (let ((part (partition (tail l) (lambda ((x A)) (lt x (head l))))))
                  (let ((less (sort ((_ tuple.select 0) part) lt)))
                  (let ((more (sort ((_ tuple.select 1) part) lt)))
                    (assume (all ((_ tuple.select 0) part) (lambda ((x A)) (lt x (head l))))
                    (assume (= (content ((_ tuple.select 0) part)) (content less))
                    (assume (all less (lambda ((x A)) (lt x (head l))))
                      (append less (Cons (head l) more))))))))
                  l)))
    (assume (= (content l) (content res)) res)))
(declare-type T ())
(declare-const l (List T))
(declare-const lt (-> T T Bool))
; the body of sort satisfies its assumption
(assert (not
  (let ((res (ite ((_ is Cons) l)
                  (let ((part (partition (tail l) (lambda ((x T)) (lt x (head l))))))
                  (let ((less (sort ((_ tuple.select 0) part) lt)))
                  (let ((more (sort ((_ tuple.select 1) part) lt)))
                    (assume (all ((_ tuple.select 0) part) (lambda ((x T)) (lt x (head l))))
                    (assume (= (content ((_ tuple.select 0) part)) (content less))
                    (assume (all less (lambda ((x T)) (lt x (head l))))
                      (append less (Cons (head l) more))))))))
                  l)))
    (= (content l) (content res)))))
(check-sat)
