(define-type PosInt () (! Int :var y :restrict (> y 0)))
; (a: {y | y > 0}) => {r: BigInt | r > a}
(define-type PosIncr () (-> (! PosInt :var a) (! Int :var r :restrict (> r a))))

(declare-const f PosIncr)
(declare-const x Int)

; guarded
(push 1)
(assert (not (=> (> x 0) (> (f x) x))))
(set-info :status unsat)
(check-sat)
(pop 1)

; unguarded
(push 1)
(assert (not (> (f x) x)))
(set-info :status sat)
(check-sat)
(pop 1)

; conditional argument
(push 1)
(assert (not (> (f (ite (> x 0) x 1)) 0)))
(set-info :status unsat)
(check-sat)
(pop 1)
