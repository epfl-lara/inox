; A set or bag lies in a quantifier's domain iff its elements do: the type check can only be
; false at an element the solver picks as a counterexample. The elements that the formula reads
; from a free bag are typed, as the results of the applications of free functions.

(define-type PosInt () (! Int :var y :restrict (> y 0)))

(declare-const x Int)
(declare-const b (Bag PosInt))

; empty
(push 1)
(declare-const g (-> (Bag Int) Int))
(assert (not (=> (forall ((w (Bag PosInt))) (= (g w) 1)) (= (g (as bag.empty Int)) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; outside domain
(push 1)
(declare-const g (-> (Bag Int) Int))
(assert (not (=> (forall ((w (Bag PosInt))) (= (g w) 1)) (= (g (bag.union (bag.union (as bag.empty Int) (bag.singleton 1 1)) (bag.singleton 0 1))) 1))))
(set-info :status sat)
(check-sat)
(pop 1)

; doesn't hold
(push 1)
(assert (not (forall ((w (Bag PosInt))) (forall ((x Int)) (=> (> (bag.multiplicity x w) 0) (> x 1))))))
(set-info :status sat)
(check-sat)
(pop 1)

; free variable
(push 1)
(assert (not (=> (= b (bag.union (as bag.empty Int) (bag.singleton x 1))) (> x 1))))
(set-info :status sat)
(check-sat)
(pop 1)

; in domain
(push 1)
(declare-const g (-> (Bag Int) Int))
(assert (not (=> (forall ((w (Bag PosInt))) (= (g w) 1)) (= (g (bag.singleton 1 1)) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; holds
(push 1)
(assert (not (forall ((w (Bag PosInt))) (forall ((x Int)) (=> (> (bag.multiplicity x w) 0) (> x 0))))))
(set-info :status unsat)
(check-sat)
(pop 1)

; free variable in domain
(push 1)
(assert (not (=> (= b (bag.union (as bag.empty Int) (bag.singleton x 1))) (> x 0))))
(set-info :status unsat)
(check-sat)
(pop 1)
