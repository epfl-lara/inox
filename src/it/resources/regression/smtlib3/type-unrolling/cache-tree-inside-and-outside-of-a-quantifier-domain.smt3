(define-type PosInt () (! Int :var y :restrict (> y 0)))
; inductive with two recursive fields
(declare-datatypes ((Tree 0)) (((Leaf) (Node (left Tree) (tv PosInt) (right Tree)))))

(declare-const t Tree)

; in domain
(push 1)
(declare-const g (-> Tree Int))
(assert (not (=> (and ((_ is Node) t) ((_ is Node) (right t))) (=> (forall ((w Tree)) (= (g w) 1)) (= (g (Node Leaf 1 Leaf)) 1)))))
(set-info :status unsat)
(check-sat)
(pop 1)

; fieldless constructor
(push 1)
(declare-const g (-> Tree Int))
(assert (not (=> (and ((_ is Node) t) ((_ is Node) (right t))) (=> (forall ((w Tree)) (= (g w) 1)) (= (g Leaf) 1)))))
(set-info :status unsat)
(check-sat)
(pop 1)

; outside domain
(push 1)
(declare-const g (-> Tree Int))
(assert (not (=> (and ((_ is Node) t) ((_ is Node) (right t))) (=> (forall ((w Tree)) (= (g w) 1)) (= (g (Node Leaf 1 (Node Leaf 0 Leaf))) 1)))))
(set-info :status sat)
(check-sat)
(pop 1)

; extended free variable
(push 1)
(declare-const g (-> Tree Int))
(assert (not (=> (forall ((w Tree)) (= (g w) 1)) (= (g (Node t 0 Leaf)) 1))))
(set-info :status sat)
(check-sat)
(pop 1)
