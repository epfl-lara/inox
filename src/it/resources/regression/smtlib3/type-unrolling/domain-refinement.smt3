(define-type PosInt () (! Int :var y :restrict (> y 0)))

; in domain
(push 1)
(declare-const g (-> Int Int))
(assert (not (=> (forall ((w PosInt)) (= (g w) 1)) (= (g 1) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; outside domain
(push 1)
(declare-const g (-> Int Int))
(assert (not (=> (forall ((w PosInt)) (= (g w) 1)) (= (g 0) 1))))
(set-info :status sat)
(check-sat)
(pop 1)

; holds
(push 1)
(assert (not (forall ((w PosInt)) (> w 0))))
(set-info :status unsat)
(check-sat)
(pop 1)

; doesn't hold
(push 1)
(assert (not (forall ((w PosInt)) (> w 1))))
(set-info :status sat)
(check-sat)
(pop 1)
