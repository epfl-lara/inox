(define-type PosInt () (! Int :var y :restrict (> y 0)))
(declare-datatypes ((List 1)) ((par (A) ((Nil) (Cons (head A) (tail (List A)))))))

; fieldless constructor
(push 1)
(declare-const g (-> (List Int) Int))
(assert (not (=> (forall ((w (List PosInt))) (= (g w) 1)) (= (g (as Nil (List Int))) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; depth 1
(push 1)
(declare-const g (-> (List Int) Int))
(assert (not (=> (forall ((w (List PosInt))) (= (g w) 1)) (= (g (Cons 1 (as Nil (List Int)))) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; depth 2
(push 1)
(declare-const g (-> (List Int) Int))
(assert (not (=> (forall ((w (List PosInt))) (= (g w) 1)) (= (g (Cons 1 (Cons 2 (as Nil (List Int))))) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; depth 1 outside domain
(push 1)
(declare-const g (-> (List Int) Int))
(assert (not (=> (forall ((w (List PosInt))) (= (g w) 1)) (= (g (Cons 0 (as Nil (List Int)))) 1))))
(set-info :status sat)
(check-sat)
(pop 1)

; depth 2 outside domain
(push 1)
(declare-const g (-> (List Int) Int))
(assert (not (=> (forall ((w (List PosInt))) (= (g w) 1)) (= (g (Cons 1 (Cons 0 (as Nil (List Int))))) 1))))
(set-info :status sat)
(check-sat)
(pop 1)

; holds at depth 1
(push 1)
(assert (not (forall ((w (List PosInt))) (=> ((_ is Cons) w) (> (head w) 0)))))
(set-info :status unsat)
(check-sat)
(pop 1)

; holds at depth 2
(push 1)
(assert (not (forall ((w (List PosInt))) (=> (and ((_ is Cons) w) ((_ is Cons) (tail w))) (> (head (tail w)) 0)))))
(set-info :status unsat)
(check-sat)
(pop 1)

; doesn't hold at depth 2
(push 1)
(assert (not (forall ((w (List PosInt))) (=> (and ((_ is Cons) w) ((_ is Cons) (tail w))) (> (head (tail w)) 1)))))
(set-info :status sat)
(check-sat)
(pop 1)
