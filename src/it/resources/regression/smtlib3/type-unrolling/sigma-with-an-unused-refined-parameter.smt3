(define-type PosInt () (! Int :var y :restrict (> y 0)))

; (a: {y | y > 0}, BigInt)
(define-type T () (Tuple (! PosInt :var a) Int))
(declare-const v T)

; in domain
(push 1)
(declare-const g (-> (Tuple Int Int) Int))
(assert (not (=> (forall ((w T)) (= (g w) 1)) (= (g (tuple 1 0)) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; outside domain
(push 1)
(declare-const g (-> (Tuple Int Int) Int))
(assert (not (=> (forall ((w T)) (= (g w) 1)) (= (g (tuple 0 0)) 1))))
(set-info :status sat)
(check-sat)
(pop 1)

; holds
(push 1)
(assert (not (forall ((w T)) (> ((_ tuple.select 0) w) 0))))
(set-info :status unsat)
(check-sat)
(pop 1)

; free variable
(push 1)
(assert (not (> ((_ tuple.select 0) v) 0)))
(set-info :status unsat)
(check-sat)
(pop 1)
