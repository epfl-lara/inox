(define-type PosInt () (! Int :var y :restrict (> y 0)))
; (a: {y | y > 0}) => {r: BigInt | r > a}
(define-type PosIncr () (-> (! PosInt :var a) (! Int :var r :restrict (> r a))))

; holds
(push 1)
(assert (not (forall ((w PosIncr)) (> (w 1) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; doesn't hold
(push 1)
(assert (not (forall ((w PosIncr)) (> (w 1) 2))))
(set-info :status sat)
(check-sat)
(pop 1)
