; The models of curried functions with refined results must satisfy the refinement, also
; with feeling-lucky.
(define-type PosInt () (! Int :var y :restrict (> y 0)))

(declare-const h (-> Int (-> Int PosInt)))

; curried result
(push 1)
(assert (not (> (@ (h 1) 2) 0)))
(set-info :status unsat)
(check-sat)
(pop 1)
