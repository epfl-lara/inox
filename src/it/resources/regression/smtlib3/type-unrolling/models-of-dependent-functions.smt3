; Applies functions outside of their domain, where the codomain only holds without
; `assume-checked` (under which applications are known to lie in the domain).
(set-option :assume-checked false)

; The models of these functions must lie in their types, including at arguments the
; query doesn't apply them to.

(define-type PosInt () (! Int :var y :restrict (> y 0)))
; (a: {y | y > 0}) => {r: BigInt | r > a}
(define-type PosIncr () (-> (! PosInt :var a) (! Int :var r :restrict (> r a))))
; (a: BigInt) => {r: BigInt | r > a}
(define-type Incr () (-> (! Int :var a) (! Int :var r :restrict (> r a))))

(declare-const g PosIncr)
(declare-const x Int)
(declare-const h Incr)
; (a: {y | y > 0}) => (b: BigInt) => {r: BigInt | a > 0 && r > b}, whose codomain is
; empty outside of the domain
(declare-const c (-> (! PosInt :var a) (-> (! Int :var b) (! Int :var r :restrict (and (> a 0) (> r b))))))
; (a: {y | y > 0}) => ({r: BigInt | r > a}, {s: BigInt | s < a})
(declare-const p (-> (! PosInt :var a) (Tuple (! Int :var r :restrict (> r a)) (! Int :var s :restrict (< s a)))))
; (a: {y | y > 0}) => (b: {y | y > a}, {c: BigInt | c > b})
(declare-const d (-> (! PosInt :var a) (Tuple (! Int :var b :restrict (> b a)) (! Int :var c :restrict (> c b)))))

; outside of the domain
(push 1)
(assert (<= (g 0) 0))
(set-info :status sat)
(check-sat)
(pop 1)

; inside and outside
(push 1)
(assert (and (> x 5) (> (g x) 7) (< (g (- 1)) 0)))
(set-info :status sat)
(check-sat)
(pop 1)

; dependent codomain
(push 1)
(assert (not (> (h 5) 6)))
(set-info :status sat)
(check-sat)
(pop 1)

; dependent codomain
(push 1)
(assert (= (h 5) 7))
(set-info :status sat)
(check-sat)
(pop 1)

; curried, inside
(push 1)
(assert (> (@ (c 1) 2) 10))
(set-info :status sat)
(check-sat)
(pop 1)

; curried, outside
(push 1)
(assert (< (@ (c 0) 2) 0))
(set-info :status sat)
(check-sat)
(pop 1)

; tuple, inside
(push 1)
(assert (> ((_ tuple.select 0) (p 1)) 5))
(set-info :status sat)
(check-sat)
(pop 1)

; tuple, outside
(push 1)
(assert (< ((_ tuple.select 0) (p 0)) 0))
(set-info :status sat)
(check-sat)
(pop 1)

; Sigma, inside
(push 1)
(assert (= ((_ tuple.select 0) (d 1)) 3))
(set-info :status sat)
(check-sat)
(pop 1)

; Sigma, outside
(push 1)
(assert (< ((_ tuple.select 1) (d 0)) 0))
(set-info :status sat)
(check-sat)
(pop 1)
