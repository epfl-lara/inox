; The domain check of `x` (contract generator) doesn't use the type of `x` (free generator),
; and needs to unfold `x` entirely, so the instantiation is never enabled (timeout).

(define-type PosInt () (! Int :var y :restrict (> y 0)))
(declare-datatypes ((List 1)) ((par (A) ((Nil) (Cons (head A) (tail (List A)))))))

(declare-const x (List PosInt))

; free variable
(push 1)
(declare-const g (-> (List Int) Int))
(assert (not (=> (forall ((w (List PosInt))) (= (g w) 1)) (= (g x) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)
