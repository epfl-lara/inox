; A map value can be decomposed as `rest.updated(k, v)` for any `rest` that agrees with it
; except at `k`, so the solver can pick a `rest` outside of the domain and falsify the type
; check of a value that is inside of it. The valid queries are then reported invalid.

(define-type PosInt () (! Int :var y :restrict (> y 0)))

; default only
(push 1)
(declare-const g (-> (Array Int Int) Int))
(assert (not (=> (forall ((w (Array Int PosInt))) (= (g w) 1)) (= (g ((as const (Array Int Int)) 1)) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)

; in domain
(push 1)
(declare-const g (-> (Array Int Int) Int))
(assert (not (=> (forall ((w (Array Int PosInt))) (= (g w) 1)) (= (g (store ((as const (Array Int Int)) 1) 0 2)) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)
