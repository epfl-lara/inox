; `pre(0)` is unrolled for the instantiation with 0, outside of the domain, and the
; result is unknown instead of invalid.

(define-type NonZero () (! Int :var y :restrict (not (= y 0))))
; pre(a) = { assume(a != 0); true }, similarly to a Stainless `require`
(define-fun pre ((a Int)) Bool (assume (not (= a 0)) true))

(define-type Guarded () (! NonZero :var x :restrict (pre x)))
(declare-const g (-> Int Int))

; refined domain
(push 1)
(assert (not (=> (forall ((w Guarded)) (and (pre w) (= (g w) 1))) (= (g 0) 1))))
(set-info :status sat)
(check-sat)
(pop 1)

; base domain
(push 1)
(assert (not (=> (forall ((w NonZero)) (and (pre w) (= (g w) 1))) (= (g 0) 1))))
(set-info :status sat)
(check-sat)
(pop 1)
