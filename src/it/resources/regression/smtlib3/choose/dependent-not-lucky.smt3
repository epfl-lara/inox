; fun5 contains a choose that depends on the choose of fun3 (regression test for feeling-lucky)
(set-info :status unsat)
(declare-type-var T)
(define-fun fun1 ((x Int)) Int (ite (<= x 0) (choose (v Int) (> v 0)) x))
(define-fun fun2 ((x Int) (y Int)) Int (ite (<= x 0) (choose (v Int) (> v 0)) (fun1 y)))
(define-fun fun3 ((x T) (b Bool)) T (ite b (choose (v T) true) x))
(define-fun-rec fun4 ((x Int) (y Int)) Int
  (ite (>= x 0) (+ (choose (v Int) (> v y)) (fun4 (- x 1) (- y 1))) 0))
(define-fun fun5 ((x Int)) Int (choose (r Int) (not (= (fun3 x true) 0))))
(set-option :feeling-lucky true)
(set-option :check-models false)
(assert (let ((x (fun5 0))) (= (fun3 0 true) 0)))
(check-sat)
