; More pairs than any fixed budget of distinguishing inputs would cover. All functions agree
; on true, so each of them needs a different result on false
(set-option :function-equality extensional)
(set-info :status sat)
(declare-const f1 (-> Bool Int))
(assert (= (f1 true) 0))
(declare-const f2 (-> Bool Int))
(assert (= (f2 true) 0))
(declare-const f3 (-> Bool Int))
(assert (= (f3 true) 0))
(declare-const f4 (-> Bool Int))
(assert (= (f4 true) 0))
(declare-const f5 (-> Bool Int))
(assert (= (f5 true) 0))
(declare-const f6 (-> Bool Int))
(assert (= (f6 true) 0))
(declare-const f7 (-> Bool Int))
(assert (= (f7 true) 0))
(declare-const f8 (-> Bool Int))
(assert (= (f8 true) 0))
(declare-const f9 (-> Bool Int))
(assert (= (f9 true) 0))
(declare-const f10 (-> Bool Int))
(assert (= (f10 true) 0))
(declare-const f11 (-> Bool Int))
(assert (= (f11 true) 0))
(declare-const f12 (-> Bool Int))
(assert (= (f12 true) 0))
(assert (distinct f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 ))
(check-sat)
