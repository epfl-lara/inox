; The distinguishing inputs mustn't keep the solver from refuting the query by unfolding size
(set-option :function-equality extensional)
(set-info :status unsat)
(declare-datatypes ((List 1)) ((par (A) ((Nil) (Cons (head A) (tail (List A)))))))
(define-fun-rec size ((l (List Int))) Int (ite ((_ is Cons) l) (+ 1 (size (tail l))) 0))
(declare-const f (-> (List Int) Int))
(declare-const g (-> (List Int) Int))
(declare-const l (List Int))
(assert (not (= f g)))
(assert (= (f l) (g l)))
(assert (= l (Cons 1 (as Nil (List Int)))))
(assert (not (= (size l) 1)))
(check-sat)
