; Without function equality, a function applied to functions is extracted as tests of its
; argument on distinguishing inputs, and lambdas get a distinguishing input instead of being
; distinct by their structure or closures
(set-option :function-equality none)
(set-info :status sat)
(declare-const k (-> (-> Int Int) Int))
(declare-const g (-> Int Int))
(declare-const a Int)
(declare-const b Int)
(push 1)
(assert (not (= (k g) (k (lambda ((x Int)) (+ x 1))))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (k (lambda ((x Int)) (+ x 1))) (k (lambda ((x Int)) (- x 1))))))
(check-sat)
(pop 1)
(assert (not (= (k (lambda ((x Int)) (+ x a))) (k (lambda ((x Int)) (+ x b))))))
(check-sat)
