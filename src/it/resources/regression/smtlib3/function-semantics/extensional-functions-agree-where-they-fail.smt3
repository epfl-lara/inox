; Under extensional equality, functions agree on the inputs on which they fail, as these
; applications make their paths infeasible
(set-option :function-equality extensional)
(set-option :assume-checked false)
(set-option :check-models true)
(declare-const y Int)
(declare-const p Bool)
(assert (= y 0))
(push 1)
(set-info :status unsat)
(assert (not (= (lambda () (div 1 y)) (lambda () 2))))
(check-sat)
(pop 1)
(set-info :status sat)
(assert (= p (= (lambda () (div 1 y)) (lambda () 2))))
(check-sat)
