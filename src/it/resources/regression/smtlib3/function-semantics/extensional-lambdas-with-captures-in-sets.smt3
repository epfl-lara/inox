; Under extensional equality, a model may only make lambdas equal whose bodies agree on every
; input, with the values of their captures in that model.
(set-option :function-equality extensional)
(set-option :no-simplifications true)
(define-fun-rec succ ((x Int)) Int (+ x 1))
(set-option :check-models false)
; the bodies of lambdas are compared with the values that the model gives their captures, and the
; input on which they differ then excludes these values
(push 1)
(declare-const c Int)
(set-info :status sat)
(assert (member (lambda ((z Int)) (= z c)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0)))))
(check-sat)
(pop 1)
(push 1)
(declare-const c Int)
(set-info :status unsat)
(assert (and (= c 1) (member (lambda ((z Int)) (= z c)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0))))))
(check-sat)
(pop 1)
; the first models usually give c another value than the one that makes the lambdas equal
(push 1)
(declare-const c Int)
(set-info :status sat)
(assert (member (lambda ((z Int)) (= (+ z c) 1)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0)))))
(check-sat)
(pop 1)
(push 1)
(declare-const c Int)
(set-info :status unsat)
(assert (and (= c 2) (member (lambda ((z Int)) (= (+ z c) 1)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0))))))
(check-sat)
(pop 1)
; partial bodies differ where exactly one of them fails
(push 1)
(set-info :status unsat)
(assert (member (lambda ((z Int)) (div z z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) 1))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (not (member (lambda ((z Int)) (div z z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) 1)))))
(check-sat)
(pop 1)
; the bodies only agree once the call in one of them is unfolded
(push 1)
(set-info :status sat)
(assert (member (lambda ((z Int)) (succ z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) (+ 1 z)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (member (lambda ((z Int)) (succ z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) (+ 1 z))))))
(check-sat)
(pop 1)
; higher-order lambdas whose bodies agree on every input
(push 1)
(set-info :status sat)
(assert (member (lambda ((f (-> Int Int))) (f 0)) (insert (as emptyset (-> (-> Int Int) Int)) (lambda ((f (-> Int Int))) (+ (f 0) 0)))))
(check-sat)
(pop 1)
; the same queries, with the models checked: the evaluator can't tell whether lambdas with different
; bodies are equal, so it can't validate the models that make them equal
(set-option :check-models true)
(push 1)
(declare-const c Int)
(set-info :status sat)
(assert (member (lambda ((z Int)) (= z c)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0)))))
(check-sat)
(pop 1)
(push 1)
(declare-const c Int)
(set-info :status unsat)
(assert (and (= c 1) (member (lambda ((z Int)) (= z c)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0))))))
(check-sat)
(pop 1)
; the first models usually give c another value than the one that makes the lambdas equal
(push 1)
(declare-const c Int)
(set-info :status sat)
(set-info :inox-may-be-unknown true)
(assert (member (lambda ((z Int)) (= (+ z c) 1)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0)))))
(check-sat)
(pop 1)
(push 1)
(declare-const c Int)
(set-info :status unsat)
(assert (and (= c 2) (member (lambda ((z Int)) (= (+ z c) 1)) (insert (as emptyset (-> Int Bool)) (lambda ((z Int)) (= z 0))))))
(check-sat)
(pop 1)
; partial bodies differ where exactly one of them fails
(push 1)
(set-info :status unsat)
(assert (member (lambda ((z Int)) (div z z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) 1))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (not (member (lambda ((z Int)) (div z z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) 1)))))
(check-sat)
(pop 1)
; the bodies only agree once the call in one of them is unfolded
(push 1)
(set-info :status sat)
(set-info :inox-may-be-unknown true)
(assert (member (lambda ((z Int)) (succ z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) (+ 1 z)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (member (lambda ((z Int)) (succ z)) (insert (as emptyset (-> Int Int)) (lambda ((z Int)) (+ 1 z))))))
(check-sat)
(pop 1)
; higher-order lambdas whose bodies agree on every input
(push 1)
(set-info :status sat)
(set-info :inox-may-be-unknown true)
(assert (member (lambda ((f (-> Int Int))) (f 0)) (insert (as emptyset (-> (-> Int Int) Int)) (lambda ((f (-> Int Int))) (+ (f 0) 0)))))
(check-sat)
(pop 1)
