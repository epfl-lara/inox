; Under extensional equality, the input on which the bodies of two lambdas differ, which models
; that make them equal must refute, can contain functions anywhere and values of abstract types.
(set-option :function-equality extensional)
(set-option :no-simplifications true)
(declare-sort S 0)
(declare-const s S)
(declare-const t S)
(declare-datatypes ((B 0)) (((Box (fn (-> Int Int))))))
(set-option :check-models false)
; a function in a tuple or in a field
(push 1)
(set-info :status unsat)
(assert (member (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 0)) (insert (as emptyset (-> (Tuple Int (-> Int Int)) Int)) (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 1)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (not (member (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 0)) (insert (as emptyset (-> (Tuple Int (-> Int Int)) Int)) (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 1))))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (member (lambda ((b B)) (@ (fn b) 0)) (insert (as emptyset (-> B Int)) (lambda ((b B)) (@ (fn b) 1)))))
(check-sat)
(pop 1)
; a function that returns functions
(push 1)
(set-info :status unsat)
(assert (member (lambda ((f (-> Int (-> Int Int)))) (@ (f 0) 1)) (insert (as emptyset (-> (-> Int (-> Int Int)) Int)) (lambda ((f (-> Int (-> Int Int)))) (@ (f 1) 0)))))
(check-sat)
(pop 1)
(push 1)
(declare-const c Int)
(set-info :status sat)
(assert (member (lambda ((f (-> Int (-> Int Int)))) (@ (f c) 1)) (insert (as emptyset (-> (-> Int (-> Int Int)) Int)) (lambda ((f (-> Int (-> Int Int)))) (@ (f 0) 1)))))
(check-sat)
(pop 1)
; a function of functions, which the input compares to its arguments
(push 1)
(set-info :status unsat)
(assert (member (lambda ((g (-> (-> Int Int) Int))) (g (lambda ((x Int)) x))) (insert (as emptyset (-> (-> (-> Int Int) Int) Int)) (lambda ((g (-> (-> Int Int) Int))) (g (lambda ((x Int)) 0))))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (member (lambda ((g (-> (-> Int Int) Int))) (g (lambda ((x Int)) x))) (insert (as emptyset (-> (-> (-> Int Int) Int) Int)) (lambda ((g (-> (-> Int Int) Int))) (+ 0 (g (lambda ((y Int)) y)))))))
(check-sat)
(pop 1)
; values of an uninterpreted sort, which are given by the captures that have them
(push 1)
(set-info :status sat)
(assert (member (lambda ((z S)) (= z s)) (insert (as emptyset (-> S Bool)) (lambda ((z S)) (= z t)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (and (not (= s t)) (member (lambda ((z S)) (= z s)) (insert (as emptyset (-> S Bool)) (lambda ((z S)) (= z t))))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (member (lambda ((f (-> S Int))) (f s)) (insert (as emptyset (-> (-> S Int) Int)) (lambda ((f (-> S Int))) 0))))
(check-sat)
(pop 1)
; the same queries, with the models checked: the evaluator decides whether lambdas with different
; bodies are equal with a solver, and so validates the models that make them equal
(set-option :check-models true)
; a function in a tuple or in a field
(push 1)
(set-info :status unsat)
(assert (member (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 0)) (insert (as emptyset (-> (Tuple Int (-> Int Int)) Int)) (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 1)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (not (member (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 0)) (insert (as emptyset (-> (Tuple Int (-> Int Int)) Int)) (lambda ((p (Tuple Int (-> Int Int)))) (@ ((_ tuple.select 1) p) 1))))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (member (lambda ((b B)) (@ (fn b) 0)) (insert (as emptyset (-> B Int)) (lambda ((b B)) (@ (fn b) 1)))))
(check-sat)
(pop 1)
; a function that returns functions
(push 1)
(set-info :status unsat)
(assert (member (lambda ((f (-> Int (-> Int Int)))) (@ (f 0) 1)) (insert (as emptyset (-> (-> Int (-> Int Int)) Int)) (lambda ((f (-> Int (-> Int Int)))) (@ (f 1) 0)))))
(check-sat)
(pop 1)
(push 1)
(declare-const c Int)
(set-info :status sat)
(assert (member (lambda ((f (-> Int (-> Int Int)))) (@ (f c) 1)) (insert (as emptyset (-> (-> Int (-> Int Int)) Int)) (lambda ((f (-> Int (-> Int Int)))) (@ (f 0) 1)))))
(check-sat)
(pop 1)
; a function of functions, which the input compares to its arguments
(push 1)
(set-info :status unsat)
(assert (member (lambda ((g (-> (-> Int Int) Int))) (g (lambda ((x Int)) x))) (insert (as emptyset (-> (-> (-> Int Int) Int) Int)) (lambda ((g (-> (-> Int Int) Int))) (g (lambda ((x Int)) 0))))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (member (lambda ((g (-> (-> Int Int) Int))) (g (lambda ((x Int)) x))) (insert (as emptyset (-> (-> (-> Int Int) Int) Int)) (lambda ((g (-> (-> Int Int) Int))) (+ 0 (g (lambda ((y Int)) y)))))))
(check-sat)
(pop 1)
; values of an uninterpreted sort, which are given by the captures that have them
(push 1)
(set-info :status sat)
(assert (member (lambda ((z S)) (= z s)) (insert (as emptyset (-> S Bool)) (lambda ((z S)) (= z t)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (and (not (= s t)) (member (lambda ((z S)) (= z s)) (insert (as emptyset (-> S Bool)) (lambda ((z S)) (= z t))))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (member (lambda ((f (-> S Int))) (f s)) (insert (as emptyset (-> (-> S Int) Int)) (lambda ((f (-> S Int))) 0))))
(check-sat)
(pop 1)
