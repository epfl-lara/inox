; Nullary lambdas are values, so a lambda whose body calls a function with an unsatisfied
; refinement doesn't constrain the variables it captures until it is applied (epfl-lara/inox#139).
; The extensional counterpart of `refined-calls/under-lambda`.
(set-option :function-equality extensional)
(set-info :status sat)
; checking the model would compare the lambdas by applying them, where the refinement of makeEqual
; doesn't hold
(set-option :check-models false)
; the model can't keep the two lambdas of type `() => Unit` equal without knowing that they agree,
; and the input that would tell them apart assumes the refinement of makeEqual, so the solver may
; not find a model
(set-info :inox-may-be-unknown true)
(declare-datatypes ((Unit 0)) (((Uu))))
(declare-datatypes ((Equations 2)) ((par (A B) ((Equation (lhs (-> A)) (rhs (-> A)) (ev (-> B)))))))
(declare-fun makeEqual ((x Int) (y Int)) (! Unit :var u :restrict (= x y)))
(declare-const x Int)
(declare-const y Int)
(declare-const eq1 (Equations Int Unit))
(declare-const eq2 (Equations Int Unit))
(assert (= eq1 (Equation (lambda () x) (lambda () x) (lambda () (makeEqual x y)))))
(assert (= eq2 (Equation (lambda () x) (lambda () x) (lambda () Uu))))
(assert (not (= y x)))
(check-sat)
