; A function fails where a call or an application that it reaches fails, which tells it apart from
; a function that doesn't fail there
(set-option :function-equality extensional)
(set-option :assume-checked false)
(set-option :check-models true)
(define-fun pre ((a Int)) Int (assume (not (= a 0)) a))
(declare-const f (-> Int Int))
(push 1)
(set-info :status sat)
(assert (not (= (lambda ((x Int)) (pre x)) (lambda ((x Int)) x))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (= (lambda ((x Int)) (pre x)) (lambda ((x Int)) (assume (not (= x 0)) x)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (= (lambda ((x Int)) (pre (+ x 1))) (lambda ((x Int)) (@ (lambda ((z Int)) (pre z)) (+ 1 x))))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (not (= (lambda ((x Int)) (pre (+ x 1))) (lambda ((x Int)) (@ (lambda ((z Int)) (pre z)) x)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (= (lambda ((x Int)) (+ x 1)) (lambda ((x Int)) (+ 1 x)))))
(check-sat)
(pop 1)
; a free function that equals a lambda fails where the lambda does
(push 1)
(set-info :status unsat)
(assert (= f (lambda ((x Int)) (div 1 x))))
(assert (= (@ f 0) 0))
(check-sat)
(pop 1)
(set-info :status sat)
(assert (= f (lambda ((x Int)) (div 1 x))))
(assert (= (@ f 1) 1))
(check-sat)
