; Functions are partial, so functions into functions into a type with a single value can differ
; in where they fail, both free functions and lambdas
(set-option :function-equality extensional)
(set-option :assume-checked false)
(set-option :check-models true)
(declare-datatypes ((U 0)) (((Uu))))
(declare-const f (-> Int (-> Int U)))
(declare-const g (-> Int (-> Int U)))
(declare-const k Int)
(push 1)
(set-info :status sat)
(assert (not (= f g)))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(assert (= k 0))
(assert (not (= (lambda ((x Int)) (lambda ((y Int)) (ite (= (div 1 k) y) Uu Uu))) (lambda ((x Int)) (lambda ((y Int)) Uu)))))
(check-sat)
(pop 1)
