; Under extensional equality, functions that agree on every input are equal
(set-option :function-equality extensional)
(set-info :status unsat)
(declare-const f (-> Int Int))
(declare-const g (-> Int Int))
(push 1)
(assert (not (= f g)))
(assert (forall ((x Int)) (= (f x) (g x))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= g (lambda ((x Int)) (g x)))))
(check-sat)
(pop 1)
(assert (not (= (lambda ((x Int)) x) (lambda ((x Int)) (ite (= x 0) 0 x)))))
(check-sat)
