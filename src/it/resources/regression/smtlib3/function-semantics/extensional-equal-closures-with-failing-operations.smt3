; Operations lifted out of lambdas under extensional equality may fail, which only fails the
; applications that evaluate them
(set-option :function-equality extensional)
(set-option :assume-checked false)
(set-option :check-models true)
(declare-const b Int)
(declare-const c Int)
(declare-const p Bool)
(define-fun l ((d Int)) (-> Int Int) (lambda ((x Int)) (ite (> x 0) (div 1 d) x)))
(assert (= b 0))
(assert (= c 0))
(push 1)
(set-info :status unsat)
(assert (not (= (l b) (l c))))
(check-sat)
(pop 1)
(set-info :status sat)
(assert (= p (= (l b) (l c))))
(assert (= (@ (l b) 0) 0))
(check-sat)
