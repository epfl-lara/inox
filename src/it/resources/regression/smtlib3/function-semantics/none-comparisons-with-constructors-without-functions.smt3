; Num(n) holds no function, so comparing an Obj with it is a constructor test, which is
; accepted without function equality
(set-option :function-equality none)
(declare-datatypes ((Obj 0)) (((Fun (objFn (-> Obj Obj))) (Num (objNum Int)))))
(declare-const o Obj)
(declare-const n Int)
(set-info :status sat)
(push 1)
(assert (= o (Num n)))
(check-sat)
(pop 1)
(push 1)
(assert (= (Num n) o))
(check-sat)
(pop 1)
(set-info :status unsat)
(assert (= o (Num n)))
(assert (not (= o (Num n))))
(check-sat)
