; f and g agree on every list of size 0 or 1, so their distinguishing input is a longer list,
; which the solver only finds by unfolding size on it
(set-option :function-equality extensional)
(set-info :status sat)
(declare-datatypes ((List 1)) ((par (A) ((Nil) (Cons (head A) (tail (List A)))))))
(define-fun-rec size ((l (List Int))) Int (ite ((_ is Cons) l) (+ 1 (size (tail l))) 0))
(declare-const f (-> (List Int) Int))
(declare-const g (-> (List Int) Int))
(assert (not (= f g)))
(assert (forall ((l (List Int))) (=> (<= (size l) 1) (= (f l) (g l)))))
(check-sat)
