; There are nine partial functions from Bool to Bool, but only four total ones
(set-option :function-equality extensional)
(declare-const f1 (-> Bool Bool))
(declare-const f2 (-> Bool Bool))
(declare-const f3 (-> Bool Bool))
(declare-const f4 (-> Bool Bool))
(declare-const f5 (-> Bool Bool))
(assert (distinct f1 f2 f3 f4 f5))
(push 1)
(set-info :status sat)
(check-sat)
(pop 1)
; functions applied by the formula are defined there
(declare-const t1 Bool)
(declare-const e1 Bool)
(assert (= t1 (@ f1 true)))
(assert (= e1 (@ f1 false)))
(declare-const t2 Bool)
(declare-const e2 Bool)
(assert (= t2 (@ f2 true)))
(assert (= e2 (@ f2 false)))
(declare-const t3 Bool)
(declare-const e3 Bool)
(assert (= t3 (@ f3 true)))
(assert (= e3 (@ f3 false)))
(declare-const t4 Bool)
(declare-const e4 Bool)
(assert (= t4 (@ f4 true)))
(assert (= e4 (@ f4 false)))
(declare-const t5 Bool)
(declare-const e5 Bool)
(assert (= t5 (@ f5 true)))
(assert (= e5 (@ f5 false)))
(set-info :status unsat)
(check-sat)
