; Steps under lambdas whose bodies may fail, which must preserve their values exactly when
; functions are compared extensionally
(set-option :function-equality extensional)
(set-option :assume-checked false)
(declare-datatypes ((List 0)) (((Nil) (Cons (head Int) (tail List)))))
(define-fun pre ((a Int)) Int (assume (not (= a 0)) a))
(declare-const f (-> Int Int))
(set-info :status unsat)
(push 1)
(assert (not (= (lambda ((x Int)) (let ((y (+ x 1))) (pre y))) (lambda ((x Int)) (pre (+ 1 x))))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (lambda ((x Int)) (head (Cons x Nil))) (lambda ((x Int)) x))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (lambda ((x Int)) (and (> x 0) true)) (lambda ((x Int)) (> x 0)))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (lambda ((x Int)) (- (+ x 2) 2)) (lambda ((x Int)) x))))
(check-sat)
(pop 1)
(push 1)
(assert (= f (lambda ((x Int)) (ite (> x 0) (pre x) (pre (- x))))))
(assert (= (@ f 3) 4))
(check-sat)
(pop 1)
(push 1)
(assert (= (lambda ((x Int)) (+ x 1)) (lambda ((x Int)) (ite (= x 5) 0 (+ x 1)))))
(check-sat)
(pop 1)
(set-info :status sat)
(push 1)
(assert (not (= (lambda ((x Int)) (head (Cons x (Cons (div 1 x) Nil)))) (lambda ((x Int)) x))))
(check-sat)
(pop 1)
