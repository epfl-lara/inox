; Ground subterms that the simplifier evaluates, through calls, conditionals and constructions
(set-option :assume-checked false)
(declare-datatypes ((List 0)) (((Nil) (Cons (head Int) (tail List)))))
(define-fun-rec len ((l List)) Int (ite ((_ is Cons) l) (+ 1 (len (tail l))) 0))
(define-fun-rec sum ((l List)) Int (ite ((_ is Cons) l) (+ (head l) (sum (tail l))) 0))
(declare-const x Int)
(set-info :status unsat)
(push 1)
(assert (= x (len (Cons 1 (Cons 2 (Cons 3 Nil))))))
(assert (not (= x 3)))
(check-sat)
(pop 1)
(push 1)
(assert (> (sum (Cons 1 (Cons (- 2) Nil))) x))
(assert (> x 0))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (str.++ "ab" "c") "abc")))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (bvadd #x0f #x01) #x10)))
(check-sat)
(pop 1)
(push 1)
(assert (= (let ((l (Cons x Nil))) (len (tail l))) 1))
(check-sat)
(pop 1)
