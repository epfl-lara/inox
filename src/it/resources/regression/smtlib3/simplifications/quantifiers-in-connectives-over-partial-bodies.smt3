; The simplifier lifts quantifiers out of the last operand of a disjunction and out of the
; conclusion of an implication, and merges nested quantifiers, where their bodies may fail
(set-option :assume-checked false)
(declare-const y Int)
(declare-const q Bool)
(declare-fun g (Int) Int)
(set-info :status unsat)
(push 1)
(assert (= y 0))
(assert (not (forall ((x Int)) (or (= x x) (forall ((z Int)) (> (div z y) 0))))))
(check-sat)
(pop 1)
(push 1)
(assert (forall ((x Int)) (or q (forall ((z Int)) (> (g z) (g x))))))
(assert (not q))
(assert (= (g 5) 0))
(check-sat)
(pop 1)
(push 1)
(assert (forall ((x Int)) (=> (> x 0) (forall ((z Int)) (> (+ x (* z z)) 0)))))
(assert (not (forall ((x Int) (z Int)) (=> (> x 0) (> (+ x (* z z)) 0)))))
(check-sat)
(pop 1)
(push 1)
(assert (forall ((x Int)) (forall ((z Int)) (=> (> x z) (> (- x z) 0)))))
(assert (exists ((a Int)) (exists ((b Int)) (and (> a b) (<= (- a b) 0)))))
(check-sat)
(pop 1)
(push 1)
(assert (exists ((x Int) (unused Bool)) (and (> x 3) (< x 2))))
(check-sat)
(pop 1)
