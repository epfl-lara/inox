; Closures in sets and in fields of constructions, whose evaluations the checker compares
(set-option :function-equality extensional)
(set-option :assume-checked false)
(declare-datatypes ((Box 0)) (((box (get (-> Int Bool))))))
(define-fun single ((a Int)) Box (box (lambda ((z Int)) (= z a))))
(declare-const s (Set (-> Int Bool)))
(set-info :status unsat)
(push 1)
(assert (= (get (single 1)) (get (single 2))))
(check-sat)
(pop 1)
(push 1)
(assert (member (get (single 0)) (insert (as emptyset (-> Int Bool)) (get (single 1)) (get (single 2)))))
(check-sat)
(pop 1)
(push 1)
(assert (not (member (lambda ((z Int)) (= z 1)) (insert (as emptyset (-> Int Bool)) (get (single 1))))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (@ (get (single 3)) 3) true)))
(check-sat)
(pop 1)
