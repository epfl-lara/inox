; Selections out of constructions of sorts with invariants, which only have a value where the
; invariant holds
(set-option :assume-checked false)
(declare-datatype Pos ((pos (pv Int))))
(datatype-invariant p Pos (> (pv p) 0))
(declare-datatype Box ((box (bv Pos) (bn Int))))
(declare-const x Int)
(declare-const b Box)
(set-info :status unsat)
(push 1)
(assert (= (pv (pos x)) 0))
(check-sat)
(pop 1)
(push 1)
(assert (<= (pv (bv b)) 0))
(check-sat)
(pop 1)
(push 1)
(assert (> x 0))
(assert (not (= (bn (box (pos x) (+ x 1))) (+ x 1))))
(check-sat)
(pop 1)
