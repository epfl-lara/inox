; Selections out of constructions and tuples whose other fields may fail, and a construction of
; the fields of a term of a known constructor
(set-option :assume-checked false)
(declare-datatypes ((List 0)) (((Nil) (Cons (head Int) (tail List)))))
(declare-const y Int)
(declare-const l List)
(set-info :status unsat)
(push 1)
(assert (not (= (head (Cons 1 (Cons (div 1 y) Nil))) 1)))
(assert (not (= y 0)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= ((_ tuple.select 0) (tuple 2 (div 3 y))) 2)))
(assert (= y 1))
(check-sat)
(pop 1)
(push 1)
(assert ((_ is Cons) l))
(assert (not (= l (Cons (head l) (tail l)))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (ite ((_ is Cons) l) (Cons (head l) (tail l)) l) l)))
(check-sat)
(pop 1)
