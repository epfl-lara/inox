; Bindings and assumptions of partial terms that the simplifier inlines, binds and lifts
(set-option :assume-checked false)
(define-fun pre ((a Int)) Int (assume (not (= a 0)) a))
(declare-const x Int)
(declare-const y Int)
(set-info :status unsat)
(push 1)
(assert (let ((a (+ x 1)) (b (pre (+ x 1)))) (not (= a b))))
(assert (not (= x (- 1))))
(check-sat)
(pop 1)
(push 1)
(assert (let ((d (div x y))) (and (= y 2) (not (= (* 2 d) (- x (mod x 2)))))))
(check-sat)
(pop 1)
(push 1)
(assert (and (> y 0) (let ((d (div x y))) (assume (>= (* d y) (- x y)) (< (* d y) (- x y))))))
(check-sat)
(pop 1)
(push 1)
(assert (forall ((z Int)) (let ((w (+ z 1))) (assume (> w z) (> (pre w) z)))))
(assert (= (pre 1) 5))
(assert (not (> 5 0)))
(check-sat)
(pop 1)
(push 1)
(assert (ite (= y 0) false (not (= (* (div x y) y) (- x (mod x y))))))
(check-sat)
(pop 1)
