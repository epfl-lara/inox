; Polynomial arithmetic that cancels operands, some of which may fail
(set-option :assume-checked false)
(declare-const x Int)
(declare-const y Int)
(set-info :status unsat)
(push 1)
(assert (not (= (- (+ x (div 1 y)) (div 1 y)) x)))
(assert (= y 1))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (* (+ x 1) (+ x 1)) (+ (+ (* x x) (* 2 x)) 1))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (+ (* 0 (div x y)) x) x)))
(assert (not (= y 0)))
(check-sat)
(pop 1)
(push 1)
(assert (forall ((z Int)) (= (+ (+ z x) (- z)) (+ x 1))))
(check-sat)
(pop 1)
